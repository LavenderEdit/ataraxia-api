# --- Configuración de la Base de Datos (MySQL) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ataraxia_db
MYSQL_USER=root
MYSQL_PASSWORD=password_secreto

# --- Configuración de la App ---
PORT=3000
NODE_ENV=development

# --- JWT (Autenticación) ---
# Generar claves seguras (ej: openssl rand -base64 32)
JWT_SECRET=super_secreto_access_token
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=super_secreto_refresh_token
JWT_REFRESH_EXPIRATION=7d

# --- Google Drive (Opcional - Para Logros) ---
# Obtener credenciales en Google Cloud Console
DRIVE_OAUTH_CLIENT_ID=
DRIVE_OAUTH_CLIENT_SECRET=
DRIVE_OAUTH_REFRESH_TOKEN=
DRIVE_FOLDER_ACHIVIEMENTS_ICON=

# --- Configuración de CORS ---
# URL del Frontend (sin barra final)
FRONTEND_URL=http://localhost:5173